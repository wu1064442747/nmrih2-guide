---
import SiteShell from '~/components/SiteShell.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The requested No More Room in Hell 2 guide page could not be found." canonicalPath="/404">
  <SiteShell>
    <section class="legal-page">
      <h1>Page not found</h1>
      <p>The guide you requested does not exist yet.</p>
      <a class="button primary" href="/">Return home</a>
    </section>
  </SiteShell>
</BaseLayout>
